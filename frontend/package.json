{
  "name": "seiran-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-twemoji-assets.mjs && node scripts/build-emoji-annotations.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@twemoji/parser": "^17.0.2",
    "@twemoji/svg": "^15.0.0",
    "emojibase-data": "^17.0.0",
    "hls.js": "^1.6.16",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "jsqr": "^1.4.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.10",
    "react-router-dom": "^7.18.2",
    "tesseract.js": "^7.0.0",
    "unicode-emoji-json": "^0.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
